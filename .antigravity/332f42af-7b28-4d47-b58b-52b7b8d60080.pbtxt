    content: "  const handleTrimWhitespace = () => {\n    onSetClipboardText(clipboardText.trim());\n  };\n\n  const handleSingleLine = () => {\n    onSetClipboardText(clipboardText.replace(/\\r?\\n+/g, \' \').trim());\n  };\n\n  // Submit sync\n  const handleSync = async () => {\n    if (!clipboardText) {\n      alert(\'\350\257\267\345\205\210\350\257\273\345\217\226\346\210\226\347\262\230\350\264\264\351\234\200\350\246\201\346\233\264\346\226\260\347\232\204\347\216\257\345\242\203\345\217\230\351\207\217\345\206\205\345\256\271\');\n      return;\n    }\n    if (!isConfigValid) {\n      alert(\'\350\257\267\345\205\210\345\256\214\346\210\220\345\221\206\345\221\206\351\235\242\346\235\277\350\277\236\346\216\245\350\256\276\347\275\256\357\274\210API\345\234\260\345\235\200\343\200\201AppKey\343\200\201AppSecret\357\274\211\');\n      onOpenSettings();\n      return;\n    }\n\n    const envName = config.targetEnvName.trim() || \'JD_COOKIE\';\n    setIsSyncing(true);\n    setLastResult(null);\n    const start = Date.now();\n\n    // Haptic vibration feedback on Android\n    if (typeof window !== \'undefined\' && \'vibrate\' in navigator) {\n      try {\n        navigator.vibrate([20, 40, 20]);\n      } catch {\n        // ignore"
