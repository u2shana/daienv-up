      arguments_json: "{\"ArtifactMetadata\":{\"RequestFeedback\":true, \"Summary\":\"\345\221\206\345\221\206\351\235\242\346\235\277\345\211\252\350\264\264\346\235\277\347\216\257\345\242\203\345\217\230\351\207\217\345\220\214\346\255\245\345\212\251\346\211\213 (Android PWA) \347\232\204\345\256\214\346\225\264\345\256\236\346\226\275\346\226\271\346\241\210\343\200\202\345\214\205\345\220\253\345\211\252\350\264\264\346\235\277\350\257\273\345\217\226\343\200\201OpenAPI AppKey/AppSecret\351\211\264\346\235\203\343\200\201\347\216\257\345\242\203\345\217\230\351\207\217\350\207\252\345\212\250\346\237\245\346\211\276\344\270\216\346\233\264\346\226\260/\345\210\233\345\273\272\343\200\201\350\277\236\346\216\245\346\265\213\350\257\225\343\200\201\345\216\206\345\217\262\350\256\260\345\275\225\344\273\245\345\217\212 Android PWA \345\256\211\350\243\205\350\247\204\350\214\203\343\200\202\", \"UserFacing\":true}, \"CodeContent\":\"# \345\221\206\345\221\206\351\235\242\346\235\277\345\211\252\350\264\264\346\235\277\347\216\257\345\242\203\345\217\230\351\207\217\345\220\214\346\255\245\345\212\251\346\211\213 (Android PWA)\\n\\n\344\270\200\344\270\252\344\270\223\344\270\272 Android \347\247\273\345\212\250\344\275\223\351\252\214\344\274\230\345\214\226\347\232\204\347\216\260\344\273\243 PWA \345\272\224\347\224\250\357\274\214\346\224\257\346\214\201\350\207\252\345\212\250\344\270\216\346\211\213\345\212\250\350\257\273\345\217\226\347\263\273\347\273\237\345\211\252\350\264\264\346\235\277\357\274\214\351\200\232\350\277\207 AppKey \345\222\214 AppSecret \351\211\264\346\235\203\346\216\245\345\205\245\345\221\206\345\221\206\351\235\242\346\235\277\357\274\210Daidai Panel\357\274\211\357\274\214\344\270\200\351\224\256\346\233\264\346\226\260\346\210\226\350\207\252\345\212\250\345\210\233\345\273\272\346\214\207\345\256\232\347\232\204\347\216\257\345\242\203\345\217\230\351\207\217\357\274\214\345\271\266\345\205\267\345\244\207\346\241\214\351\235\2