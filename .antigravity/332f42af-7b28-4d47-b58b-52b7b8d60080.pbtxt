      id: "call_365863"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport {\\n  Save,\\n  CheckCircle2,\\n  AlertTriangle,\\n  RotateCw,\\n  Eye,\\n  EyeOff,\\n  Server,\\n  Key,\\n  ShieldCheck,\\n  Tag,\\n  Zap,\\n  Globe,\\n  Upload,\\n  Download,\\n  HelpCircle,\\n} from \'lucide-react\';\\nimport { PanelConfig } from \'../types\';\\nimport { testConnection } from \'../services/daidaiApi\';\\n\\ninterface SettingsViewProps {\\n  config: PanelConfig;\\n  onSaveConfig: (newConfig: PanelConfig) => void;\\n  onOpenGuide: () => void;\\n}\\n\\nexport const SettingsView: React.FC<SettingsViewProps> = ({\\n  config,\\n  onSaveConfig,\\n  onOpenGuide,\\n}) => {\\n  const [formData, setFormData] = useState<PanelConfig>({ ...config });\\n  const [showSecret, setShowSecret] = useState(false);\\n  const [isTesting, setIsTesting] = useState(false);\\n  const [testResult, setTestResult] = useState<{\\n    success: boolean;\\n    message: string;\\n    latencyMs: number;\\n    envCount?: number;\\n  } | null>(null);\\n  const [saveToast, setSaveToast] = useState(false);\\n\\n  const handleSave = () => {\\n    onSaveConfig(formData);\\n    setSaveToast(true);\\n    setTimeout(() => setSaveToast(false), 2000);\\n  };\\n\\n  const handleTest = async () => {\\n    setIsTesting(true);\\n    setTestResult(null);\\n    try {\\n      const res = await testConnection(formData);\\n      setTestResult(res);\\n    } catch (err: unknown) {\\n      setTestResult({\\n        success: false,\\n        message: err instanceof Error ? err.message : String(err),\\n        latencyMs: 0,\\n      });\\n    } finally {\\n      setIsTesting(false);\\n    }\\n  };\\n\\n  // Demo sample fill\\n  const handleFillDemo = () => {\\n    setFormData({\\n      apiUrl: \'http://192.168.1.100:5678\',\\n      appKey: \'dd_app_89f3a1e\',\\n      appSecret: \'sec_98d7f2a1b4c3e80f\',\\n      targetEnvName: \'JD_COOKIE\',\\n      remarks: \'\345\221\206\345\221\206\345\211\252\350\264\264\346\235\277\345\212\251\346\211\213\350\207\252\345\212\250\346\233\264\346\226\260\',\\n      autoReadOnLaunch: true,\\n      proxyMode: \'auto\',\\n    });\\n  };\\n\\n  // Export JSON\\n  const handleExportJson = () => {\\n    const dataStr = \'data:text/json;charset=utf-8,\' + encodeURIComponent(JSON.stringify(formData, null, 2));\\n    const downloadAnchor = document.createElement(\'a\');\\n    downloadAnchor.setAttribute(\'href\', dataStr);\\n    downloadAnchor.setAttribute(\'download\', `daidai_config_${Date.now()}.json`);\\n    document.body.appendChild(downloadAnchor);\\n    downloadAnchor.click();\\n    downloadAnchor.remove();\\n  };\\n\\n  // Import JSON\\n  const handleImportJson = (e: React.ChangeEvent<HTMLInputElement>) => {\\n    const file = e.target.files?.[0];\\n    if (!file) return;\\n    const reader = new FileReader();\\n    reader.onload = (event) => {\\n      try {\\n        const parsed = JSON.parse(event.target?.result as string);\\n        setFormData((prev) => ({ ...prev, ...parsed }));\\n        alert(\'\351\205\215\347\275\256\345\267\262\346\210\220\345\212\237\350\257\273\345\217\226\357\274\201\350\257\267\347\202\271\345\207\273\344\270\213\346\226\271\343\200\220\344\277\235\345\255\230\345\275\223\345\211\215\350\256\276\347\275\256\343\200\221\343\200\202\');\\n      } catch {\\n        alert(\'\350\257\273\345\217\226\351\205\215\347\275\256\346\226\207\344\273\266\345\244\261\350\264\245\357\274\214\350\257\267\347\241\256\350\256\244\346\226\207\344\273\266\346\240\274\345\274\217\344\270\272\346\234\211\346\225\210 JSON\343\200\202\');\\n      }\\n    };\\n    reader.readAsText(file);\\n  };\\n\\n  return (\\n    <div className=\\\"max-w-2xl mx-auto px-4 pt-4 pb-28 space-y-4\\\">\\n      {/* Settings Top Card */}\\n      <div className=\\\"bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-4\\\">\\n        <div className=\\\"flex items-center justify-between pb-3 border-b border-slate-800\\\">\\n          <div>\\n            <h2 className=\\\"text-sm font-semibold text-slate-100\\\">\345\221\206\345\221\206\351\235\242\346\235\277\350\277\236\346\216\245\345\217\202\346\225\260</h2>\\n            <p className=\\\"text-xs text-slate-400 mt-0.5\\\">\\n              \345\211\215\345\276\200\345\221\206\345\221\206\351\235\242\346\235\277\345\220\216\345\217\260\343\200\220\345\272\224\347\224\250\343\200\221\350\216\267\345\217\226 OpenAPI \350\256\277\351\227\256\345\257\206\351\222\245\\n            </p>\\n          </div>\\n          <button\\n            onClick={onOpenGuide}\\n            className=\\\"flex items-center gap-1 text-xs text-blue-400 hover:text-blue-300\\\"\\n          >\\n            <HelpCircle className=\\\"w-3.5 h-3.5\\\" />\\n            <span>\350\216\267\345\217\226\346\214\207\345\274\225</span>\\n          </button>\\n        </div>\\n\\n        {/* Form Fields */}\\n        <div className=\\\"space-y-3.5\\\">\\n          {/* API URL */}\\n          <div>\\n            <label className=\\\"block text-xs font-medium text-slate-300 mb-1 flex items-center gap-1.5\\\">\\n              <Server className=\\\"w-3.5 h-3.5 text-blue-400\\\" />\\n              <span>\345\221\206\345\221\206\351\235\242\346\235\277 API \345\234\260\345\235\200 (\346\240\271\350\267\257\345\276\204)</span>\\n            </label>\\n            <input\\n              type=\\\"text\\\"\\n              value={formData.apiUrl}\\n              onChange={(e) => setFormData({ ...formData, apiUrl: e.target.value })}\\n              placeholder=\\\"\345\246\202 http://192.168.1.100:5678 \346\210\226 https://daidai.yourdomain.com\\\"\\n              className=\\\"w-full bg-slate-950 border border-slate-800 focus:border-blue-500 rounded-xl px-3 py-2 text-xs text-slate-200 font-mono focus:outline-none transition\\\"\\n            />\\n            <p className=\\\"text-[11px] text-slate-500 mt-1\\\">\\n              \345\217\257\345\241\253\345\206\231\345\206\205\347\275\221 IP + \347\253\257\345\217\243\357\274\214\346\210\226\345\205\254\347\275\221\345\267\262\347\251\277\351\200\217/\345\217\215\345\220\221\344\273\243\347\220\206\347\232\204 HTTPS \345\237\237\345\220\215\343\200\202\\n            </p>\\n          </div>\\n\\n          {/* AppKey */}\\n          <div>\\n            <label className=\\\"block text-xs font-medium text-slate-300 mb-1 flex items-center gap-1.5\\\">\\n              <Key className=\\\"w-3.5 h-3.5 text-emerald-400\\\" />\\n              <span>\345\272\224\347\224\250 AppKey</span>\\n            </label>\\n            <input\\n              type=\\\"text\\\"\\n              value={formData.appKey}\\n              onChange={(e) => setFormData({ ...formData, appKey: e.target.value })}\\n              placeholder=\\\"\351\235\242\346\235\277\345\220\216\345\217\260\347\224\237\346\210\220\347\232\204 AppKey\\\"\\n              className=\\\"w-full bg-slate-950 border border-slate-800 focus:border-blue-500 rounded-xl px-3 py-2 text-xs text-slate-200 font-mono focus:outline-none transition\\\"\\n            />\\n          </div>\\n\\n          {/* AppSecret */}\\n          <div>\\n            <label className=\\\"block text-xs font-medium text-slate-300 mb-1 flex items-center justify-between\\\">\\n              <span className=\\\"flex items-center gap-1.5\\\">\\n                <ShieldCheck className=\\\"w-3.5 h-3.5 text-amber-400\\\" />\\n                <span>\345\272\224\347\224\250 AppSecret</span>\\n              </span>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setShowSecret(!showSecret)}\\n                className=\\\"text-[11px] text-slate-400 hover:text-slate-200 flex items-center gap-1\\\"\\n              >\\n                {showSecret ? <EyeOff className=\\\"w-3 h-3\\\" /> : <Eye className=\\\"w-3 h-3\\\" />}\\n                <span>{showSecret ? \'\351\232\220\350\227\217\' : \'\346\230\276\347\244\272\'}</span>\\n              </button>\\n            </label>\\n            <input\\n              type={showSecret ? \'text\' : \'password\'}\\n              value={formData.appSecret}\\n              onChange={(e) => setFormData({ ...formData, appSecret: e.target.value })}\\n              placeholder=\\\"\351\235\242\346\235\277\345\220\216\345\217\260\347\224\237\346\210\220\347\232\204 AppSecret\\\"\\n              className=\\\"w-full bg-slate-950 border border-slate-800 focus:border-blue-500 rounded-xl px-3 py-2 text-xs text-slate-200 font-mono focus:outline-none transition\\\"\\n            />\\n          </div>\\n\\n          {/* Default Target Env Name */}\\n          <div>\\n            <label className=\\\"block text-xs font-medium text-slate-300 mb-1 flex items-center gap-1.5\\\">\\n              <Tag className=\\\"w-3.5 h-3.5 text-blue-400\\\" />\\n              <span>\351\273\230\350\256\244\347\233\256\346\240\207\347\216\257\345\242\203\345\217\230\351\207\217\345\220\215</span>\\n            </label>\\n            <input\\n              type=\\\"text\\\"\\n              value={formData.targetEnvName}\\n              onChange={(e) => setFormData({ ...formData, targetEnvName: e.target.value })}\\n              placeholder=\\\"\345\246\202 JD_COOKIE, BILI_COOKIE, TOKEN_VAL\\\"\\n              className=\\\"w-full bg-slate-950 border border-slate-800 focus:border-blue-500 rounded-xl px-3 py-2 text-xs text-slate-200 font-mono focus:outline-none transition\\\"\\n            />\\n            <p className=\\\"text-[11px] text-slate-500 mt-1\\\">\\n              \346\257\217\346\254\241\345\234\250\345\267\245\344\275\234\345\217\260\345\220\214\346\255\245\346\227\266\357\274\214\344\271\237\345\217\257\344\270\264\346\227\266\345\277\253\346\215\267\346\233\264\346\215\242\345\217\230\351\207\217\345\220\215\343\200\202\\n            </p>\\n          </div>\\n\\n          {/* Remarks */}\\n          <div>\\n            <label className=\\\"block text-xs font-medium text-slate-300 mb-1\\\">\345\220\214\346\255\245\345\244\207\346\263\250 (\345\217\257\351\200\211)</label>\\n            <input\\n              type=\\\"text\\\"\\n              value={formData.remarks || \'\'}\\n              onChange={(e) => setFormData({ ...formData, remarks: e.target.value })}\\n              placeholder=\\\"\347\224\261\345\221\206\345\221\206\345\211\252\350\264\264\346\235\277\345\212\251\346\211\213\350\207\252\345\212\250\346\233\264\346\226\260\\\"\\n              className=\\\"w-full bg-slate-950 border border-slate-800 focus:border-blue-500 rounded-xl px-3 py-2 text-xs text-slate-200 focus:outline-none transition\\\"\\n            />\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Advanced App Behavior Card */}\\n      <div className=\\\"bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-4\\\">\\n        <h3 className=\\\"text-sm font-semibold text-slate-100\\\">\350\277\220\350\241\214\344\270\216\347\275\221\347\273\234\347\255\226\347\225\245</h3>\\n\\n        {/* Auto-read toggle */}\\n        <div className=\\\"flex items-center justify-between py-1\\\">\\n          <div>\\n            <p className=\\\"text-xs font-medium text-slate-200\\\">\345\220\257\345\212\250\345\272\224\347\224\250\346\227\266\350\207\252\345\212\250\350\257\273\345\217\226\345\211\252\350\264\264\346\235\277</p>\\n            <p className=\\\"text-[11px] text-slate-400 mt-0.5\\\">\\n              \346\211\223\345\274\200\345\272\224\347\224\250\345\215\263\350\207\252\345\212\250\350\257\273\345\217\226\345\271\266\345\241\253\345\205\245\345\267\245\344\275\234\345\214\272\357\274\210\346\265\217\350\247\210\345\231\250\345\267\262\346\216\210\346\235\203\345\211\215\346\217\220\344\270\213\357\274\211\\n            </p>\\n          </div>\\n          <button\\n            onClick={() =>\\n              setFormData({ ...formData, autoReadOnLaunch: !formData.autoReadOnLaunch })\\n            }\\n            className={`w-11 h-6 rounded-full transition-colors relative p-0.5 ${\\n              formData.autoReadOnLaunch ? \'bg-blue-600\' : \'bg-slate-800\'\\n            }`}\\n          >\\n            <div\\n              className={`w-5 h-5 rounded-full bg-white transition-transform ${\\n                formData.autoReadOnLaunch ? \'translate-x-5\' : \'translate-x-0\'\\n              }`}\\n            />\\n          </button>\\n        </div>\\n\\n        {/* Proxy Mode */}\\n        <div className=\\\"pt-2 border-t border-slate-800/80\\\">\\n          <label className=\\\"block text-xs font-medium text-slate-200 mb-2 flex items-center gap-1.5\\\">\\n            <Globe className=\\\"w-3.5 h-3.5 text-blue-400\\\" />\\n            <span>\347\275\221\347\273\234\344\270\255\347\273\247\344\270\216\350\267\250\345\237\237\347\255\226\347\225\245</span>\\n          </label>\\n          <div className=\\\"grid grid-cols-3 gap-2\\\">\\n            {[\\n              { id: \'auto\', title: \'\346\231\272\350\203\275\345\233\236\351\200\200\', desc: \'\347\233\264\350\277\236\345\244\261\350\264\245\350\207\252\345\212\250\350\265\260\344\273\243\347\220\206\' },\\n              { id: \'direct\', title: \'\347\272\257\347\233\264\350\277\236\', desc: \'\350\256\276\345\244\207\347\233\264\350\276\276\351\235\242\346\235\277\' },\\n              { id: \'proxy\', title: \'\345\205\250\344\273\243\347\220\206\', desc: \'\344\270\255\347\273\247\350\275\254\345\217\221(\345\205\215CORS)\' },\\n            ].map((item) => {\\n              const active = formData.proxyMode === item.id;\\n              return (\\n                <button\\n                  key={item.id}\\n                  onClick={() =>\\n                    setFormData({ ...formData, proxyMode: item.id as \'auto\' | \'direct\' | \'proxy\' })\\n                  }\\n                  className={`p-2.5 rounded-xl border text-left transition ${\\n                    active\\n                      ? \'border-blue-500 bg-blue-950/20 text-white\'\\n                      : \'border-slate-800 bg-slate-950 text-slate-400 hover:border-slate-700\'\\n                  }`}\\n                >\\n                  <p className=\\\"text-xs font-medium\\\">{item.title}</p>\\n                  <p className=\\\"text-[10px] text-slate-500 mt-0.5 leading-tight\\\">{item.desc}</p>\\n                </button>\\n              );\\n            })}\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Test Connection Button & Result */}\\n      <div className=\\\"bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3\\\">\\n        <div className=\\\"flex items-center justify-between\\\">\\n          <div>\\n            <h3 className=\\\"text-xs font-medium text-slate-200\\\">\350\277\236\346\216\245\344\270\216\346\235\203\351\231\220\350\257\212\346\226\255</h3>\\n            <p className=\\\"text-[11px] text-slate-500\\\">\351\252\214\350\257\201 API \345\234\260\345\235\200\350\277\236\351\200\232\346\200\247\345\217\212 AppKey \350\257\273\345\206\231\346\235\203\351\231\220</p>\\n          </div>\\n          <button\\n            onClick={handleTest}\\n            disabled={isTesting || !formData.apiUrl || !formData.appKey}\\n            className=\\\"flex items-center gap-1.5 px-3 py-1.5 bg-slate-800 hover:bg-slate-700 disabled:opacity-40 text-slate-200 text-xs font-medium rounded-xl border border-slate-700 transition active:scale-[0.98] min-h-[38px]\\\"\\n          >\\n            <RotateCw className={`w-3.5 h-3.5 ${isTesting ? \'animate-spin text-blue-400\' : \'\'}`} />\\n            <span>{isTesting ? \'\346\255\243\345\234\250\350\257\212\346\226\255...\' : \'\346\265\213\350\257\225\350\277\236\346\216\245\'}</span>\\n          </button>\\n        </div>\\n\\n        {testResult && (\\n          <div\\n            className={`p-3 rounded-xl border text-xs ${\\n              testResult.success\\n                ? \'bg-emerald-950/40 border-emerald-800/60 text-emerald-200\'\\n                : \'bg-rose-950/40 border-rose-800/60 text-rose-200\'\\n            }`}\\n          >\\n            <div className=\\\"flex items-start gap-2\\\">\\n              {testResult.success ? (\\n                <CheckCircle2 className=\\\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\\\" />\\n              ) : (\\n                <AlertTriangle className=\\\"w-4 h-4 text-rose-400 shrink-0 mt-0.5\\\" />\\n              )}\\n              <div className=\\\"flex-1\\\">\\n                <div className=\\\"flex items-center justify-between font-semibold\\\">\\n                  <span>{testResult.success ? \'\351\235\242\346\235\277\350\256\244\350\257\201\346\210\220\345\212\237\' : \'\350\277\236\346\216\245\350\257\212\346\226\255\345\244\261\350\264\245\'}</span>\\n                  <span className=\\\"font-mono text-[11px] tabular-nums font-normal text-slate-400\\\">\\n                    \350\200\227\346\227\266 {testResult.latencyMs}ms\\n                  </span>\\n                </div>\\n                <p className=\\\"mt-1 leading-relaxed opacity-90\\\">{testResult.message}</p>\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n      </div>\\n\\n      {/* Backup & Import Tools */}\\n      <div className=\\\"flex items-center justify-between text-xs text-slate-400 pt-1\\\">\\n        <div className=\\\"flex items-center gap-2\\\">\\n          <button\\n            onClick={handleExportJson}\\n            className=\\\"flex items-center gap-1 px-2.5 py-1.5 bg-slate-800/80 hover:bg-slate-800 text-slate-300 rounded-lg transition\\\"\\n          >\\n            <Download className=\\\"w-3.5 h-3.5\\\" />\\n            <span>\345\257\274\345\207\272\351\205\215\347\275\256</span>\\n          </button>\\n\\n          <label className=\\\"flex items-center gap-1 px-2.5 py-1.5 bg-slate-800/80 hover:bg-slate-800 text-slate-300 rounded-lg cursor-pointer transition\\\">\\n            <Upload className=\\\"w-3.5 h-3.5\\\" />\\n            <span>\345\257\274\345\205\245\351\205\215\347\275\256</span>\\n            <input type=\\\"file\\\" accept=\\\".json\\\" onChange={handleImportJson} className=\\\"hidden\\\" />\\n          </label>\\n        </div>\\n\\n        <button\\n          onClick={handleFillDemo}\\n          className=\\\"text-slate-500 hover:text-slate-300 underline text-[11px]\\\"\\n        >\\n          \345\241\253\345\205\245\346\274\224\347\244\272\347\244\272\344\276\213\\n        </button>\\n      </div>\\n\\n      {/* Save Button */}\\n      <div className=\\\"pt-2\\\">\\n        <button\\n          onClick={handleSave}\\n          className=\\\"w-full h-12 bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm rounded-xl flex items-center justify-center gap-2 shadow-lg shadow-blue-600/30 transition active:scale-[0.98]\\\"\\n        >\\n          <Save className=\\\"w-4 h-4\\\" />\\n          <span>\344\277\235\345\255\230\345\275\223\345\211\215\350\256\276\347\275\256</span>\\n        </button>\\n      </div>\\n\\n      {saveToast && (\\n        <div className=\\\"fixed bottom-20 left-1/2 -translate-x-1/2 z-50 bg-emerald-600 text-white text-xs px-4 py-2 rounded-xl shadow-xl flex items-center gap-1.5 animate-bounce\\\">\\n          <CheckCircle2 className=\\\"w-4 h-4\\\" />\\n          <span>\351\205\215\347\275\256\345\267\262\346\210\220\345\212\237\344\277\235\345\255\230\357\274\201</span>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Settings component to configure API URL, AppKey, AppSecret, and connection test\", \"Overwrite\":true, \"TargetFile\":\"/src/components/SettingsView.tsx\", \"toolAction\":\"Writing file\", \"toolSummary\":\"Create src/components/SettingsView.tsx\"}"
      thinking_signature: "\022\372\f\n\367\f\001i\024}\023s\017\211\177\032\005}w.\026|\341\252P\370\337\257\264\337\316)\f\323\317:\320S)[=\324\351\272`\250\001\033\374\024\315\177\023\223\343\036x\262K\tBO\215\226i\231vXaqO3\306\300\276\217\324\371\343B\335\345\f\2148\321\363\203\366o\016{\002j>3l\2610>\336\003\233\354\b\"DK\366V\271HM\213x\323\376\225\344\364F9]\242\032\272\026\356\303\252\000\262\340vo\236\004]x\331\312f\306\345\352G\237\365\330\004d\350^\301a\017\246n8\2235\353\241a%\224~n\320Y\343t\310\344Z\230\036\325#<?&\223:\024\307\343\375C\335h\325Gi\255\244\302U\271\213\2229\304\273cq\261/\363\267\316\366\301\355\320\320|\f\343[x|y_/\243\343:\031\212\214rG~\330\220\323J\337\264x\334<U\333u\246D\265nhA77_|\020\3041%W{T\016o*\026\203\367\277o\336\236\031j\246}\326{Ac\226$\217\321g\333\366\270\002\325\b\022\204\315\332\262\332\002t\266\356E\336.\"\255H\232]zg\215\253\276!\024\244T\212\264(p.\204\314\204\353`\357\200/\335K\345\033&t\340\327\2547\222\202z\362\177\213{7\3109GLgc\314\ba\2209\226\a9;,\223\b\337\326\220\226\346\231!\226\v^4O\217\261q\034\030\223\320\305R\353\340D\'\0045\253\a\267Wy?\357#\335\274\263\307\355e\305\354\aKE@5\020Qc3,\250m\005\306\375B\354:;:uJ3d\344>:\2035M\364q\026\023\027\306\260{\022\350xG6\376\224\352o\201.\027#vv\003\003\210s\354\243\330\225[\351\331jO\222\n\306\310;\214`\304\246\270X\240\330\302/\a\265\210J\244\275\352\364}]\017\261\t\026\030T\275\324\253n\204$\205\302V\254#\3004\021\356\r\302\246\021 (\330\301}\263\'e\2704~\025\271\363\235M\255\2625L\250\177\211\333\320\253\241\277P}\211\374\234\342\253\301\313L0)\256\240QM#\340{\374\234\377\016\233\347\375T\270R\225GxT\252\006\334\224\257\235\356(\310\272~\360\313\264rL\017\347A\361\240\213\314\221GG\356)FK}\275\246,n3\227;\326\322\336\375\207\030v?x\335~v\365qmb\265\232\216\'\362\207p\304\347R\244b\226P[\270\241\363\236L\3410\f\343\245pM\313d\035]\323\325\"\305nZ\247~\n\315\233\352\222\036N\320\246\251&\r*\264\330LK\337\301\224\rI\316\377\2367/\227\024{\3754\305\324\244j\34