      create_file {
        instruction: "import React from \'react\';\nimport { X, Smartphone, KeyRound, DownloadCloud, CheckCircle2, ExternalLink } from \'lucide-react\';\n\ninterface AndroidGuideModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const AndroidGuideModal: React.FC<AndroidGuideModalProps> = ({ isOpen, onClose }) => {\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-4 overflow-y-auto\">\n      <div className=\"w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl overflow-hidden my-6\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between px-5 py-4 border-b border-slate-800 bg-slate-900/80\">\n          <div className=\"flex items-center gap-2\">\n            <Smartphone className=\"w-5 h-5 text-blue-400\" />\n            <h3 className=\"font-semibold text-slate-100 text-sm\">Android \344\275\277\347\224\250\344\270\216\345\256\211\350\243\205\346\214\207\345\274\225</h3>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 text-slate-400 hover:text-slate-200 rounded-lg hover:bg-slate-800 transition\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Body content */}\n        <div className=\"p-5 space-y-4 text-xs text-slate-300 max-h-[75vh] overflow-y-auto leading-relaxed\">\n          {/* Step 1 */}\n          <div className=\"bg-slate-950 border border-slate-800/80 rounded-xl p-3.5 space-y-2\">\n            <div className=\"flex items-center gap-2 font-semibold text-blue-400 text-xs\">\n              <DownloadCloud className=\"w-4 h-4 shrink-0\" />\n              <span>1. \346\267\273\345\212\240\350\207\263 Android \346\211\213\346\234\272\346\241\214\351\235\242 (PWA \345\216\237\347\224\237\344\275\223\351\252\214)</span>\n            </div>\n            <p className=\"text-slate-400\">\n              \345\234\250\346\211\213\346\234\272 Chrome\343\200\201Edge \346\210\226\350\207\252\345\270\246\346\265\217\350\247\210\345\231\250\344\270\255\346\211\223\345\274\200\346\234\254\347\253\231\357\274\232\n            </p>\n            <ol className=\"list-decimal list-inside space-y-1 text-slate-300 pl-1\">\n              <li>\347\202\271\345\207\273\351\241\266\351\203\250\345\257\274\350\210\252\346\240\217\347\232\204\343\200\220\345\256\211\350\243\205\345\272\224\347\224\250\343\200\221\346\214\211\351\222\256\357\274\233</li>\n              <li>\346\210\226\347\202\271\345\207\273\346\265\217\350\247\210\345\231\250\345\217\263\344\270\212\350\247\222\343\200\220\344\270\211\347\202\271\350\217\234\345\215\225\343\200\221 -&gt; \351\200\211\346\213\251\343\200\220\345\256\211\350\243\205\345\272\224\347\224\250\343\200\221\346\210\226\343\200\220\346\267\273\345\212\240\345\210\260\344\270\273\345\261\217\345\271\225\343\200\221\357\274\233</li>\n              <li>\345\256\211\350\243\205\345\220\216\357\274\214\346\211\213\346\234\272\346\241\214\351\235\242\345\260\206\347\224\237\346\210\220\347\213\254\347\253\213\345\272\224\347\224\250\345\233\276\346\240\207\357\274\214\346\213\245\346\234\211\345\205\250\345\261\217\343\200\201\346\262\211\346\265\270\345\274\217\343\200\201\346\236\201\351\200\237\347\247\222\345\274\200\347\232\204\345\216\237\347\224\237\344\275\223\351\252\214\343\200\202</li>\n            </ol>\n          </div>\n\n          {/* Step 2 */}\n          <div className=\"bg-slate-950 border border-slate-800/80 rounded-xl p-3.5 space-y-2\">\n            <div className=\"flex items-center gap-2 font-semibold text-emerald-400 text-xs\">\n              <KeyRound className=\"w-4 h-4 shrink-0\" />\n              <span>2. \345\246\202\344\275\225\345\234\250\345\221\206\345\221\206\351\235\242\346\235\277\350\216\267\345\217\226 AppKey \344\270\216 AppSecret</span>\n            </div>\n            <p className=\"text-slate-400\">\n              \345\221\206\345\221\206\351\235\242\346\235\277\351\207\207\347\224\250 Open API \350\247\204\350\214\203\351\211\264\346\235\203\357\274\232\n            </p>\n            <ol className=\"list-decimal list-inside space-y-1 text-slate-300 pl-1\">\n              <li>\347\231\273\345\275\225\346\202\250\347\232\204\345\221\206\345\221\206\351\235\242\346\235\277\345\220\216\345\217\260\357\274\210\351\200\232\345\270\270\344\270\272 <code className=\"text-slate-200\">http://&lt;IP&gt;:5678</code>\357\274\211\357\274\233</li>\n              <li>\345\234\250\345\267\246\344\276\247\345\257\274\350\210\252\350\277\233\345\205\245\343\200\220\345\272\224\347\224\250\347\256\241\347\220\206\343\200\221\346\210\226\343\200\220Open API\343\200\221\351\241\265\351\235\242\357\274\233</li>\n              <li>\347\202\271\345\207\273\343\200\220\346\226\260\345\273\272\345\272\224\347\224\250\343\200\221\357\274\214\350\276\223\345\205\245\345\272\224\347\224\250\345\220\215\347\247\260\357\274\210\345\246\202\342\200\234\345\211\252\350\264\264\346\235\277\345\212\251\346\211\213\342\200\235\357\274\211\357\274\233</li>\n              <li>\346\235\203\351\231\220\345\210\227\350\241\250\344\270\255\345\212\241\345\277\205\345\213\276\351\200\211\343\200\220\347\216\257\345\242\203\345\217\230\351\207\217\343\200\221\357\274\210\346\210\226 envs \347\233\270\345\205\263\350\257\273\345\206\231\346\235\203\351\231\220\357\274\211\357\274\233</li>\n              <li>\345\210\233\345\273\272\346\210\220\345\212\237\345\220\216\357\274\214\345\244\215\345\210\266\345\257\271\345\272\224\347\232\204 <code className=\"text-blue-300\">AppKey</code> \344\270\216 <code className=\"text-emerald-300\">AppSecret</code> \345\241\253\345\205\245\346\234\254\345\267\245\345\205\267\343\200\220\350\256\276\347\275\256\343\200\221\344\270\255\344\277\235\345\255\230\345\215\263\345\217\257\343\200\202</li>\n            </ol>\n            <a\n              href=\"https://github.com/linzixuanzz/daidai-panel\"\n              target=\"_blank\"\n              rel=\"noreferrer\"\n              className=\"inline-flex items-center gap-1 text-[11px] text-blue-400 hover:underline pt-1\"\n            >\n              <span>\346\237\245\347\234\213\345\221\206\345\221\206\351\235\242\346\235\277 GitHub \345\256\230\346\226\271\346\226\207\346\241\243</span>\n              <ExternalLink className=\"w-3 h-3\" />\n            </a>\n          </div>\n\n          {/* Step 3 */}\n          <div className=\"bg-slate-950 border border-slate-800/80 rounded-xl p-3.5 space-y-2\">\n            <div className=\"flex items-center gap-2 font-semibold text-amber-400 text-xs\">\n              <CheckCircle2 className=\"w-4 h-4 shrink-0\" />\n              <span>3. \347\247\273\345\212\250\347\253\257\346\236\201\351\200\237\345\220\214\346\255\245\345\260\217\347\252\215\351\227\250</span>\n            </div>\n            <ul className=\"list-disc list-inside space-y-1 text-slate-300 pl-1\">\n              <li>\n                <strong>\344\270\200\351\224\256\350\257\273\345\217\226</strong>\357\274\232\345\234\250\345\276\256\344\277\241\343\200\201\344\272\254\344\270\234\346\210\226\345\205\266\344\273\226\345\272\224\347\224\250\344\270\255\345\244\215\345\210\266 Cookie \346\210\226\346\226\207\346\234\254\345\220\216\357\274\214\347\233\264\346\216\245\347\202\271\345\274\200\346\241\214\351\235\242\347\232\204\345\221\206\345\221\206\345\212\251\346\211\213\357\274\214\345\274\200\345\220\257\342\200\234\345\220\257\345\212\250\350\207\252\345\212\250\350\257\273\345\217\226\342\200\235\345\215\263\345\217\257\350\207\252\345\212\250\345\241\253\345\205\205\343\200\202\n              </li>\n              <li>\n                <strong>\345\217\230\351\207\217\350\207\252\345\212\250\345\210\233\345\273\272</strong>\357\274\232\350\213\245\351\235\242\346\235\277\344\270\255\345\260\232\346\234\252\350\256\276\347\275\256\350\257\245\345\217\230\351\207\217\357\274\214\345\272\224\347\224\250\344\274\232\350\207\252\345\212\250\345\210\233\345\273\272\345\257\271\345\272\224\351\241\271\357\274\214\346\227\240\351\234\200\344\272\213\345\205\210\345\234\250\351\235\242\346\235\277\344\270\255\346\267\273\345\212\240\343\200\202\n              </li>\n              <li>\n                <strong>\347\275\221\347\273\234\350\267\250\345\237\237\344\270\216\345\261\200\345\237\237\347\275\221\350\257\264\346\230\216</strong>\357\274\232\350\213\245\351\235\242\346\235\277\350\277\220\350\241\214\345\234\250\345\206\205\347\275\221\345\261\200\345\237\237\347\275\221\357\274\210\345\246\202 192.168.x.x\357\274\211\357\274\214\346\211\213\346\234\272\345\244\204\344\272\216\345\220\214\344\270\200 WiFi \344\270\213\345\217\257\345\274\200\345\220\257\343\200\220\346\231\272\350\203\275\345\233\236\351\200\200\343\200\221\346\210\226\343\200\220\345\205\250\344\273\243\347\220\206\343\200\221\346\250\241\345\274\217\347\225\205\351\200\232\350\256\277\351\227\256\343\200\202\n              </li>\n            </ul>\n          </div>\n        </div>\n\n        {/* Footer */}\n        <div className=\"p-4 border-t border-slate-800 bg-slate-900/90 flex justify-end\">\n          <button\n            onClick={onClose}\n            className=\"w-full py-2.5 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-xs font-semibold transition\"\n          >\n            \345\256\214\346\210\220\345\271\266\350\277\224\345\233\236\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/AndroidGuideModal.tsx"
        }
        overwrite: true
      }
    }
