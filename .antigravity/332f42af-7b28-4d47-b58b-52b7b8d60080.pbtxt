        instruction: "import { EnvItem, PanelConfig } from \'../types\';\n\ninterface CachedToken {\n  token: string;\n  expiresAt: number;\n  appKey: string;\n}\n\nlet memoryTokenCache: CachedToken | null = null;\n\nexport function normalizeApiUrl(rawUrl: string): string {\n  let url = (rawUrl || \'\').trim();\n  if (!url) return \'\';\n  if (!/^https?:\\/\\//i.test(url)) {\n    url = `http://${url}`;\n  }\n  return url.replace(/\\/+$/, \'\');\n}\n\n/**\n * Executes a network request to Daidai Panel, supporting direct browser calls\n * and automatic server proxy fallback for CORS / Mixed-Content resilience.\n */\nasync function callPanelApi<T = unknown>(\n  targetUrl: string,\n  method: string,\n  headers: Record<string, string>,\n  bodyData: unknown,\n  proxyMode: \'auto\' | \'direct\' | \'proxy\' = \'auto\'\n): Promise<{ status: number; data: T }> {\n  const serializedBody = bodyData ? JSON.stringify(bodyData) : undefined;\n  const mergedHeaders: Record<string, string> = {\n    \'Accept\': \'application/json\',\n    ...(serializedBody ? { \'Content-Type\': \'application/json\' } : {}),\n    ...headers,\n  };\n\n  // If user forced proxy mode\n  if (proxyMode === \'proxy\') {\n    return callViaBackendProxy<T>(targetUrl, method, mergedHeaders, bodyData);\n  }\n\n  // Attempt direct call first\n  try {\n    const controller = new AbortController();\n    const timeoutId = setTimeout(() => controller.abort(), 8000);\n\n    const directRes = await fetch(targetUrl, {\n      method,\n      headers: mergedHeaders,\n      body: serializedBody,\n      signal: controller.signal,\n    });\n    clearTimeout(timeoutId);\n\n    const text = await directRes.text();\n    let parsed: unknown = text;\n    try {\n      parsed = JSON.parse(text);\n    } catch {\n      // plain text response\n    }\n\n    // If server returned a response (even 4xx/5xx), return it directly\n    return { status: directRes.status, data: parsed as T };\n  } catch (err: unknown) {\n    // If direct failed (CORS error, Mixed Content, or network failure), and proxyMode is \'auto\', fallback\n    if (proxyMode === \'auto\') {\n      console.warn(\'Direct fetch failed (likely CORS or Mixed Content), trying backend proxy:\', err);\n      return callViaBackendProxy<T>(targetUrl, method, mergedHeaders, bodyData);\n    }\n    const errMessage = err instanceof Error ? err.message : String(err);\n    throw new Error(`\347\233\264\346\216\245\350\277\236\346\216\245\345\244\261\350\264\245 (${errMessage})\343\200\202\346\217\220\347\244\272\357\274\232\350\213\245\351\201\207\345\210\260\350\267\250\345\237\237(CORS)\346\210\226HTTPS\346\267\267\345\220\210\345\206\205\345\256\271\351\231\220\345\210\266\357\274\214\345\217\257\345\234\250\350\256\276\347\275\256\344\270\255\345\210\207\346\215\242\344\270\272\342\200\234\346\234\215\345\212\241\347\253\257\344\273\243\347\220\206\342\200\235\346\250\241\345\274\217\343\200\202`);\n  }\n}\n\nasync function callViaBackendProxy<T>(\n  targetUrl: string,\n  method: string,\n  headers: Record<string, string>,\n  bodyData: unknown\n): Promise<{ status: number; data: T }> {\n  const proxyRes = await fetch(\'/api/daidai-proxy\', {\n    method: \'POST\',\n    headers: {\n      \'Content-Type\': \'application/json\',\n    },\n    body: JSON.stringify({\n      targetUrl,\n      method,\n      headers,\n      body: bodyData,\n    }),\n  });\n\n  const text = await proxyRes.text();\n  let parsed: unknown = text;\n  try {\n    parsed = JSON.parse(text);\n  } catch {\n    // raw text\n  }\n\n  if (!proxyRes.ok && typeof parsed === \'object\' && parsed !== null && \'message\' in parsed) {\n    throw new Error((parsed as { message: string }).message);\n  }\n\n  return { status: proxyRes.status, data: parsed as T };\n}\n\n/**\n * Retrieve Open API Bearer Token using appKey and appSecret.\n * Caches token for 23 hours to avoid hitting call limits.\n */\nexport async function getAuthToken(config: PanelConfig, forceRefresh = false): Promise<string> {\n  const base = normalizeApiUrl(config.apiUrl);\n  if (!base) throw new Error(\'\350\257\267\345\205\210\345\234\250\350\256\276\347\275\256\344\270\255\345\241\253\345\206\231\345\221\206\345\221\206\351\235\242\346\235\277 API \345\234\260\345\235\200\');\n  if (!config.appKey?.trim() || !config.appSecret?.trim()) {\n    throw new Error(\'\350\257\267\345\205\210\345\234\250\350\256\276\347\275\256\344\270\255\345\241\253\345\206\231 AppKey \344\270\216 AppSecret\');\n  }\n\n  const now = Date.now();\n  if (\n    !forceRefresh &&\n    memoryTokenCache &&\n    memoryTokenCache.appKey === config.appKey &&\n    memoryTokenCache.expiresAt > now + 60 * 1000\n  ) {\n    return memoryTokenCache.token;\n  }\n\n  const tokenUrl = `${base}/api/v1/open-api/token`;\n  const res = await callPanelApi<{\n    code?: number;\n    data?: string | { token?: string };\n    token?: string;\n    message?: string;\n    msg?: string;\n  }>(\n    tokenUrl,\n    \'POST\',\n    {},\n    {\n      appKey: config.appKey.trim(),\n      appSecret: config.appSecret.trim(),\n    },\n    config.proxyMode || \'auto\'\n  );\n\n  const resData = res.data;\n  let token = \'\';\n\n  if (resData && typeof resData === \'object\') {\n    if (typeof resData.data === \'string\') {\n      token = resData.data;\n    } else if (resData.data && typeof resData.data === \'object\' && \'token\' in resData.data) {\n      token = String(resData.data.token);\n    } else if (\'token\' in resData) {\n      token = String(resData.token);\n    }\n  }\n\n  if (!token) {\n    const errorMsg =\n      (resData && typeof resData === \'object\' && (resData.message || resData.msg)) ||\n      `\347\212\266\346\200\201\347\240\201 ${res.status}\357\274\214\346\234\252\350\277\224\345\233\236\346\234\211\346\225\210 Token`;\n    throw new Error(`\350\216\267\345\217\226\345\221\206\345\221\206\351\235\242\346\235\277 Token \345\244\261\350\264\245: ${errorMsg}`);\n  }\n\n  // Cache token for 23 hours (Daidai panel token lasts 24 hours)\n  memoryTokenCache = {\n    token,\n    expiresAt: now + 23 * 60 * 60 * 1000,\n    appKey: config.appKey,\n  };\n\n  return token;\n}\n\n/**\n * Diagnostic test connection to Daidai Panel\n */\nexport async function testConnection(config: PanelConfig): Promise<{\n  success: boolean;\n  message: string;\n  latencyMs: number;\n  envCount?: number;\n}> {\n  const startTime = Date.now();\n  try {\n    const token = await getAuthToken(config, true);\n    const envs = await getEnvs(config, token);\n    const latencyMs = Date.now() - startTime;\n    return {\n      success: true,\n      message: `\350\277\236\346\216\245\346\210\220\345\212\237\357\274\201\350\256\244\350\257\201\351\200\232\350\277\207\357\274\214\345\275\223\345\211\215\351\235\242\346\235\277\345\205\261\345\214\205\345\220\253 ${envs.length} \344\270\252\347\216\257\345\242\203\345\217\230\351\207\217\343\200\202`,\n      latencyMs,\n      envCount: envs.length,\n    };\n  } catch (err: unknown) {\n    const latencyMs = Date.now() - startTime;\n    const msg = err instanceof Error ? err.message : String(err);\n    return {\n      success: false,\n      message: msg,\n      latencyMs,\n    };\n  }\n}\n\n/**\n * Fetch environment variables from Daidai Panel\n */\nexport async function getEnvs(config: PanelConfig, token?: string, searchValue?: string): Promise<EnvItem[]> {\n  const authToken = token || (await getAuthToken(config));\n  const base = normalizeApiUrl(config.apiUrl);\n  \n  let envsUrl = `${base}/api/v1/envs`;\n  if (searchValue) {\n    envsUrl += `?searchValue=${encodeURIComponent(searchValue.trim())}`;\n  }\n\n  const res = await callPanelApi<{\n    code?: number;\n    data?: EnvItem[] | { data?: EnvItem[]; envs?: EnvItem[] };\n    message?: string;\n  }>(\n    envsUrl,\n    \'GET\',\n    {\n      Authorization: `Bearer ${authToken}`,\n    },\n    null,\n    config.proxyMode || \'auto\'\n  );\n\n  let list: EnvItem[] = [];\n  const raw = res.data;\n\n  if (Array.isArray(raw)) {\n    list = raw;\n  } else if (raw && typeof raw === \'object\') {\n    if (Array.isArray(raw.data)) {\n      list = raw.data;\n    } else if (raw.data && typeof raw.data === \'object\') {\n      if (Array.isArray(raw.data.data)) {\n        list = raw.data.data;\n      } else if (Array.isArray(raw.data.envs)) {\n        list = raw.data.envs;\n      }\n    }\n  }\n\n  return list;\n}\n\n/**\n * Smart Upsert Environment Variable:\n * 1. Queries panel to see if variable already exists (exact name match)\n * 2. If exists -> calls PUT /api/v1/envs/:id to update value\n * 3. If does not exist -> calls POST /api/v1/envs to create\n */\nexport async function syncEnvValue(\n  config: PanelConfig,\n  targetName: string,\n  newValue: string,\n  customRemarks?: string\n): Promise<{\n  action: \'updated\' | \'created\';\n  envId: string | number;\n  message: string;\n  previousValue?: string;\n}> {\n  const trimmedName = targetName.trim();\n  if (!trimmedName) throw new Error(\'\347\216\257\345\242\203\345\217\230\351\207\217\345\220\215\344\270\215\350\203\275\344\270\272\347\251\272\');\n  if (newValue === undefined || newValue === null) throw new Error(\'\347\216\257\345\242\203\345\217\230\351\207\217\345\200\274\344\270\215\350\203\275\344\270\272\347\251\272\');\n\n  const token = await getAuthToken(config);\n  const base = normalizeApiUrl(config.apiUrl);\n\n  // Search existing envs\n  const envs = await getEnvs(config, token, trimmedName);\n  const existing = envs.find((item) => item.name === trimmedName);\n\n  const remarks = customRemarks?.trim() || existing?.remarks || \'\347\224\261\345\221\206\345\221\206\345\211\252\350\264\264\346\235\277\345\220\214\346\255\245\345\212\251\346\211\213\350\207\252\345\212\250\346\233\264\346\226\260\';\n\n  if (existing && existing.id !== undefined) {\n    // Update existing environment variable\n    const updateUrl = `${base}/api/v1/envs/${existing.id}`;\n    const payload = {\n      id: existing.id,\n      name: trimmedName,\n      value: newValue,\n      remarks,\n    };\n\n    const res = await callPanelApi<{ code?: number; message?: string; msg?: string }>(\n      updateUrl,\n      \'PUT\',\n      { Authorization: `Bearer ${token}` },\n      payload,\n      config.proxyMode || \'auto\'\n    );\n\n    if (res.status >= 400) {\n      // In case panel expects PUT /api/v1/envs without ID in path\n      const fallbackUrl = `${base}/api/v1/envs`;\n      await callPanelApi(\n        fallbackUrl,\n        \'PUT\',\n        { Authorization: `Bearer ${token}` },\n        payload,\n        config.proxyMode || \'auto\'\n      );\n    }\n\n    return {\n      action: \'updated\',\n      envId: existing.id,\n      message: `\346\210\220\345\212\237\346\233\264\346\226\260\347\216\257\345\242\203\345\217\230\351\207\217 [${trimmedName}]`,\n      previousValue: existing.value,\n    };\n  } else {\n    // Create new environment variable\n    const createUrl = `${base}/api/v1/envs`;\n    \n    // Most Daidai / Qinglong panels support batch array [{ name, value, remarks }]\n    // We try array first, if rejected try single object\n    const batchPayload = [\n      {\n        name: trimmedName,\n        value: newValue,\n        remarks,\n      },\n    ];\n\n    try {\n      const res = await callPanelApi<{\n        code?: number;\n        data?: EnvItem | EnvItem[];\n        message?: string;\n      }>(\n        createUrl,\n        \'POST\',\n        { Authorization: `Bearer ${token}` },\n        batchPayload,\n        config.proxyMode || \'auto\'\n      );\n\n      let createdId: string | number = \'new\';\n      if (res.data?.data) {\n        if (Array.isArray(res.data.data) && res.data.data[0]?.id) {\n          createdId = res.data.data[0].id;\n        } else if (typeof res.data.data === \'object\' && \'id\' in res.data.data) {\n          createdId = (res.data.data as { id: string | number }).id;\n        }\n      }\n\n      return {\n        action: \'created\',\n        envId: createdId,\n        message: `\347\233\256\346\240\207\345\217\230\351\207\217\344\270\215\345\255\230\345\234\250\357\274\214\345\267\262\345\234\250\345\221\206\345\221\206\351\235\242\346\235\277\350\207\252\345\212\250\345\210\233\345\273\272 [${trimmedName}]`,\n      };\n    } catch {\n      // Fallback to single object payload\n      const singlePayload = {\n        name: trimmedName,\n        value: newValue,\n        remarks,\n      };\n      await callPanelApi(\n        createUrl,\n        \'POST\',\n        { Authorization: `Bearer ${token}` },\n        singlePayload,\n        config.proxyMode || \'auto\'\n      );\n\n      return {\n        action: \'created\',\n        envId: \'new\',\n        message: `\347\233\256\346\240\207\345\217\230\351\207\217\344\270\215\345\255\230\345\234\250\357\274\214\345\267\262\345\234\250\345\221\206\345\221\206\351\235\242\346\235\277\350\207\252\345\212\250\345\210\233\345\273\272 [${trimmedName}]`,\n      };\n    }\n  }\n}\n"
